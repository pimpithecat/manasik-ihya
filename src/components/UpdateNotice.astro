<div class="update-notice" data-update-notice hidden role="status" aria-live="polite">
  <span>Versi baru tersedia.</span>
  <button class="btn btn--quiet update-notice__reload" type="button" data-update-reload>
    Muat ulang
  </button>
  <button
    class="update-notice__close"
    type="button"
    data-update-dismiss
    aria-label="Tutup pemberitahuan"
  >
    &times;
  </button>
</div>

<script>
  const notice = document.querySelector<HTMLElement>('[data-update-notice]')
  const reloadButton = document.querySelector<HTMLButtonElement>('[data-update-reload]')
  const dismissButton = document.querySelector<HTMLButtonElement>('[data-update-dismiss]')

  if ('serviceWorker' in navigator) {
    // Hanya anggap "update" jika sebelumnya sudah ada SW yang mengontrol.
    const hadController = Boolean(navigator.serviceWorker.controller)
    let asked = false

    const show = () => {
      if (notice) notice.hidden = false
    }
    const hide = () => {
      if (notice) notice.hidden = true
    }

    navigator.serviceWorker
      .register('/sw.js', { scope: '/' })
      .then((registration) => {
        // Update yang sudah menunggu saat halaman dibuka.
        if (registration.waiting && hadController) show()

        registration.addEventListener('updatefound', () => {
          const worker = registration.installing
          if (!worker) return
          worker.addEventListener('statechange', () => {
            if (worker.state === 'installed' && hadController) show()
          })
        })

        // Periksa update saat aplikasi kembali dibuka, bukan hanya saat reload.
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') {
            registration.update().catch(() => {})
          }
        })
      })
      .catch(() => {})

    navigator.serviceWorker.addEventListener('controllerchange', () => {
      if (asked) {
        window.location.reload()
        return
      }
      if (hadController) show()
    })

    reloadButton?.addEventListener('click', async () => {
      asked = true
      try {
        const registration = await navigator.serviceWorker.getRegistration()
        if (registration?.waiting) {
          registration.waiting.postMessage({ type: 'SKIP_WAITING' })
          // Jaring pengaman bila controllerchange tidak datang.
          window.setTimeout(() => window.location.reload(), 800)
        } else {
          window.location.reload()
        }
      } catch {
        window.location.reload()
      }
    })

    dismissButton?.addEventListener('click', hide)
  }
</script>
