---
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <a class="wordmark" href="/">Manasik Ihya'</a>

  <nav class="site-footer__links" aria-label="Navigasi kaki">
    <a href="/panduan/">Panduan</a>
    <a href="/cetak/">Cetak buku</a>
    <a href="/sumber/">Sumber</a>
  </nav>

  <button class="site-footer__install" type="button" data-install hidden>
    Pasang aplikasi
  </button>
  <span class="site-footer__ios" data-ios-install hidden>
    Pasang di iPhone: tombol Bagikan → Tambah ke Layar Utama.
  </span>

  <span class="offline-state" data-offline-state data-state="idle" title="Seluruh isi tersimpan setelah halaman dibuka sekali">
    <span class="offline-state__dot" aria-hidden="true"></span>
    <span data-offline-text>Menyiapkan offline</span>
  </span>

  <p class="site-footer__note">
    Disarikan dari <em>Ihya' 'Ulum al-Din</em> karya Imam al-Ghazali. Ini panduan bacaan, bukan fatwa;
    ikuti bimbingan mutawwif dan ahli ilmu di lapangan. &copy; {year}
  </p>
</footer>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-offline-state]')
  const label = wrap?.querySelector<HTMLElement>('[data-offline-text]')

  function paint() {
    if (!wrap || !label) return
    if (!navigator.onLine) {
      wrap.dataset.state = 'offline'
      label.textContent = 'Mode offline'
      return
    }
    const ready = 'serviceWorker' in navigator && Boolean(navigator.serviceWorker.controller)
    wrap.dataset.state = ready ? 'ready' : 'idle'
    label.textContent = ready ? 'Siap offline' : 'Menyiapkan offline'
  }

  paint()
  window.addEventListener('online', paint)
  window.addEventListener('offline', paint)
  navigator.serviceWorker?.addEventListener('controllerchange', paint)

  // Pasang sebagai aplikasi (PWA).
  interface InstallPromptEvent extends Event {
    prompt: () => Promise<void>
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>
  }

  const installButton = document.querySelector<HTMLButtonElement>('[data-install]')
  const iosHint = document.querySelector<HTMLElement>('[data-ios-install]')
  let deferred: InstallPromptEvent | null = null

  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault()
    deferred = event as InstallPromptEvent
    if (installButton) installButton.hidden = false
  })

  installButton?.addEventListener('click', async () => {
    if (!deferred) return
    await deferred.prompt()
    try {
      await deferred.userChoice
    } catch {}
    deferred = null
    installButton.hidden = true
  })

  window.addEventListener('appinstalled', () => {
    if (installButton) installButton.hidden = true
    if (iosHint) iosHint.hidden = true
  })

  const standalone =
    window.matchMedia('(display-mode: standalone)').matches ||
    (navigator as Navigator & { standalone?: boolean }).standalone === true
  const isIos =
    /iPad|iPhone|iPod/.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)

  if (!standalone && isIos && iosHint) iosHint.hidden = false
</script>
