---
interface Item {
  name: string
  href?: string
}

interface Props {
  items: Item[]
}

const { items } = Astro.props
---

<nav class="breadcrumb" aria-label="Jalur halaman">
  {
    items.map((item, index) => (
      <>
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.href ? (
          <a href={item.href}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
      </>
    ))
  }
</nav>
