---
const path = Astro.url.pathname
const items = [
  { href: '/panduan/', label: 'Panduan', match: '/panduan' },
  { href: '/dua/', label: 'Doa', match: '/dua' },
  { href: '/manasik/', label: 'Manasik', match: '/manasik' },
  { href: '/baca/', label: 'Baca', match: '/baca' },
]
const isActive = (match: string) => path === match || path.startsWith(`${match}/`)
---

<header class="site-header">
  <a class="wordmark" href="/">Manasik Ihya'</a>

  <nav class="site-nav" aria-label="Navigasi utama">
    {
      items.map((item) => (
        <a href={item.href} aria-current={isActive(item.match) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="header-actions">
    <a class="link" href="/sumber/">Sumber</a>
    <button class="theme-toggle" data-theme-toggle type="button" aria-label="Ubah mode gelap" title="Ubah mode gelap">
      <svg
        class="icon-sun"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
      <svg
        class="icon-moon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
      </svg>
    </button>
  </div>
</header>
